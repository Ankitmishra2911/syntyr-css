{
  "name": "@syntyr/docs-codemirror-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Maintainer-only pinned CodeMirror 6 build for the static Syntyr documentation playground",
  "type": "module",
  "scripts": {
    "build": "node patch-rectangular-selection.mjs && esbuild src/editor.mjs --bundle --minify --format=iife --target=es2022 --legal-comments=eof --outfile=../../docs/playground-editor.js"
  },
  "dependencies": {
    "codemirror": "6.0.2",
    "@codemirror/lang-html": "6.4.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
